# Comma-separated dataset codes, or ALL
EIA_DATASETS=STEO,TOTAL,INTL,SEDS,IEO

# Path to DuckDB database file
EIA_DB_PATH=data/eia_bulk.duckdb

# Directory for downloaded zips and DB
